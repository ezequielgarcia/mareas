# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Generated output -- every figure is reproducible by running the programs
figures/

# uv.lock IS committed on purpose: it pins exact versions so the numbers in the
# README are reproducible.

# Generated slides -- rebuild with slides/make_slides.py
slides/*.pdf
slides/*-png/

# charla.pdf IS committed on purpose: it is the deck as given, so it can be
# downloaded and projected without installing anything.
!slides/charla.pdf
